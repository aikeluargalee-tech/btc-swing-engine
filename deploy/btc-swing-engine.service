[Unit]
Description=BTC Swing Microstructure & Auction Engine
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/btc_swing_engine
Environment=TERM=xterm-256color
Environment=LANG=en_US.UTF-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/btc_swing_engine/.venv/bin/python /home/ubuntu/btc_swing_engine/main.py --tab p
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/btc_swing_engine/logs/service.log
StandardError=append:/home/ubuntu/btc_swing_engine/logs/service_err.log

# Resource protection for e2-micro 1GB instance
MemoryMax=850M
MemoryHigh=750M

[Install]
WantedBy=multi-user.target
